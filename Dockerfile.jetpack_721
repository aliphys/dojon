# JetPack 7.2.1 / L4T r39.2.1 developer image (Ubuntu 24.04 Noble, aarch64).
# Target: Jetson AGX Thor and Orin devkits running BSP 39.2.x.

FROM nvcr.io/nvidia/base/ubuntu:24.04

ARG VIDEO_GID=44
ARG RENDER_GID=993
RUN set -eux; \
    if getent group video  >/dev/null; then groupmod -g ${VIDEO_GID}  video;  else groupadd -r -g ${VIDEO_GID}  video;  fi; \
    if getent group render >/dev/null; then groupmod -g ${RENDER_GID} render; else groupadd -r -g ${RENDER_GID} render; fi

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    bc \
    build-essential \
    bzip2 \
    can-utils \
    ca-certificates \
    curl \
    file \
    git \
    gnupg2 \
    gstreamer1.0-alsa \
    gstreamer1.0-libav \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-tools \
    gstreamer1.0-x \
    i2c-tools \
    iputils-ping \
    iw \
    kbd \
    kmod \
    language-pack-en-base \
    libcanberra-gtk3-module \
    locales \
    libdrm-dev \
    libgles2 \
    libglvnd-dev \
    libgtk-3-0 \
    libudev1 \
    libvulkan1 \
    libxv1 \
    libzmq5 \
    mtd-utils \
    nano \
    openssh-client \
    parted \
    pciutils \
    python-is-python3 \
    python3 \
    python3-pexpect \
    python3-pip \
    python3-pip-whl \
    python3-numpy \
    python3-setuptools \    
    python3-wheel \
    python3-yaml \
    rsync \
    sox \
    udev \
    vulkan-tools \
    wget \
    wireless-tools \
    wpasupplicant \
    x11-apps \
    xauth \
    xxd \
    zstd \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean


# Generate the en_US.UTF-8 locale and set it as the default. 
RUN locale-gen en_US.UTF-8 && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8


# Configure the NVIDIA Jetson apt repository (JetPack 7.2.1 -> r39.2).
# GPG key, pin file, and three sources.list entries in one layer.
ARG RELEASE=r39.2
RUN wget -P /etc/apt/trusted.gpg.d https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
 && wget -P /etc/apt/preferences.d https://repo.download.nvidia.com/jetson/nvidia-repo-pin-600 \
 && echo "deb https://repo.download.nvidia.com/jetson/common ${RELEASE} main" >  /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
 && echo "deb https://repo.download.nvidia.com/jetson/som    ${RELEASE} main" >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
 && echo "deb https://repo.download.nvidia.com/jetson/ffmpeg ${RELEASE} main" >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list


# JetPack 7.2.1 dev SDK components.
# For a runtime-only image drop cuda-toolkit-13-2 (keep cuda-libraries-13-2 + cuda-compat-13-2) and
# swap each *-dev for the matching runtime meta.
RUN mkdir -p /lib/firmware/ \
 && apt-get update && apt-get install -y --no-install-recommends \
        cuda-toolkit-13-2 \
        cuda-libraries-13-2 \
        libcudla-dev-13-2 \
        nvidia-cudnn-dev \
        nvidia-tensorrt-dev \
        nvidia-vpi-dev \
        nvidia-opencv-dev \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

# cuda-compat has a postinst that fights the driver install inside a
# container; extract it manually the same way the jp6 image does.
RUN apt-get update && apt-get download cuda-compat-13-2 \
 && dpkg-deb -R ./cuda-compat-13-2_*_arm64.deb ./cuda-compat \
 && cp -r ./cuda-compat/usr/local/* /usr/local/ \
 && rm -rf ./cuda-compat-13-2_*_arm64.deb ./cuda-compat /var/lib/apt/lists/*

# Multimedia API samples & libs. Postinst calls sudo which is not present in
# the base container, so strip it before running.
RUN apt-get update && apt-get download nvidia-l4t-jetson-multimedia-api \
    && dpkg-deb -R ./nvidia-l4t-jetson-multimedia-api_*_arm64.deb ./mm-api \
    && cp -r ./mm-api/usr/src/jetson_multimedia_api /usr/src/jetson_multimedia_api \
    && sed -i 's/sudo//' ./mm-api/DEBIAN/postinst \
    && ./mm-api/DEBIAN/postinst \
    && rm -rf ./nvidia-l4t-jetson-multimedia-api_*_arm64.deb ./mm-api

# GStreamer NVIDIA plugins. Same container-hostile postinst pattern.
RUN apt-get update && apt-get download nvidia-l4t-gstreamer \
    && dpkg-deb -R ./nvidia-l4t-gstreamer_*_arm64.deb ./gstreamer \
    && cp -r ./gstreamer/usr/bin/* /usr/bin/ \
    && cp -r ./gstreamer/usr/lib/* /usr/lib/ \
    && rm -rf ./nvidia-l4t-gstreamer_*_arm64.deb ./gstreamer

# Environment
ENV CUDA_HOME="/usr/local/cuda"
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64"

# Auto-detect the live GPU's compute capability at container start and export
# TORCH_CUDA_ARCH_LIST with correct arch for Jetson Thor or Orin
COPY --chmod=755 <<'EOF' /usr/local/bin/nvidia-cuda-arch-entrypoint.sh
#!/usr/bin/env bash
set -e
if [[ -z "${TORCH_CUDA_ARCH_LIST:-}" ]] && [[ -x /usr/local/cuda/bin/__nvcc_device_query ]]; then
    cap="$(/usr/local/cuda/bin/__nvcc_device_query 2>/dev/null || true)"
    if [[ "$cap" =~ ^[0-9]+$ ]]; then
        export TORCH_CUDA_ARCH_LIST="${cap%?}.${cap: -1}"
    fi
fi
exec "$@"
EOF
ENTRYPOINT ["/usr/local/bin/nvidia-cuda-arch-entrypoint.sh"]
CMD ["bash"]

# Final image plumbing:
#   - ld.so.conf entries for tegra userspace libs. On L4T r39.x these live
#     under aarch64-linux-gnu/nvidia (nv_tegra_release:
#     TARGET_USERSPACE_LIB_DIR=nvidia); older tegra/tegra-egl paths kept
#     for compat with anything that hard-codes them. The nvidia-container
#     runtime bind-mounts host libs into these paths at run time.
#   - Force NVIDIA EGL + wayland ICDs over Mesa (50_mesa.json is removed).
#   - Final ldconfig picks up the gstreamer libs installed earlier and the
#     new ld.so.conf entries.
#   - Drop the NVIDIA apt repo bootstrap so downstream `apt update` in
#     derived images doesn't accidentally pull JetPack packages.
RUN echo "/usr/lib/aarch64-linux-gnu/nvidia"     >  /etc/ld.so.conf.d/nvidia-tegra.conf \
 && echo "/usr/lib/aarch64-linux-gnu/tegra"      >> /etc/ld.so.conf.d/nvidia-tegra.conf \
 && echo "/usr/lib/aarch64-linux-gnu/tegra-egl"  >> /etc/ld.so.conf.d/nvidia-tegra.conf \
 && rm -f /usr/share/glvnd/egl_vendor.d/50_mesa.json \
 && mkdir -p /usr/share/glvnd/egl_vendor.d/ /usr/share/egl/egl_external_platform.d/ \
 && printf '{\n  "file_format_version" : "1.0.0",\n  "ICD" : { "library_path" : "libEGL_nvidia.so.0" }\n}\n' \
      > /usr/share/glvnd/egl_vendor.d/10_nvidia.json \
 && printf '{\n  "file_format_version" : "1.0.0",\n  "ICD" : { "library_path" : "libnvidia-egl-wayland.so.1" }\n}\n' \
      > /usr/share/egl/egl_external_platform.d/nvidia_wayland.json \
 && ldconfig \
 && rm -f /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
          /etc/apt/preferences.d/nvidia-repo-pin-600 \
          /etc/apt/trusted.gpg.d/jetson-ota-public.asc

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
